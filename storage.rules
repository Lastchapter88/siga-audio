rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function adminEmail() {
      return signedIn()
        && (
          request.auth.token.email == 'sigastreetaudio@gmail.com'
          || request.auth.token.email == 'luckysekhula@gmail.com'
          || request.auth.token.email == 'sbudax.mlindo03@gmail.com'
        );
    }

    match /proofs/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }

    match /combos/{allPaths=**} {
      allow read: if true;
      allow write: if adminEmail();
    }

    match /catalog/{allPaths=**} {
      allow read: if true;
      allow write: if adminEmail();
    }

    match /site/{allPaths=**} {
      allow read: if true;
      allow write: if adminEmail();
    }
  }
}
