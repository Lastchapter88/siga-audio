rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminEmail() {
      return signedIn()
        && (
          request.auth.token.email == 'sigastreetaudio@gmail.com'
          || request.auth.token.email == 'luckysekhula@gmail.com'
          || request.auth.token.email == 'sbudax.mlindo03@gmail.com'
        );
    }

    match /combos/{id} {
      allow read: if true;
      allow write: if adminEmail();
    }

    match /comboMedia/{id} {
      allow read: if true;
      allow write: if adminEmail();
    }

    match /siteMedia/{id} {
      allow read: if true;
      allow write: if adminEmail();
    }

    match /bookings/{id} {
      // Strict: only allowlisted admins can read booking data
      allow read: if adminEmail();
      allow create: if signedIn();
      allow update, delete: if adminEmail();
    }

    match /siteEvents/{id} {
      allow read: if adminEmail();
      allow create: if true;
      allow update, delete: if false;
    }

    match /slots/{id} {
      allow read, write: if true;
    }

    match /pageContent/{id} {
      allow read: if true;
      allow write: if adminEmail();
    }

    match /siteSettings/{id} {
      allow read: if true;
      allow write: if adminEmail();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || adminEmail());
      allow create: if signedIn()
        && request.auth.uid == uid
        && (adminEmail() || request.resource.data.role == 'customer');
      allow update: if signedIn()
        && request.auth.uid == uid
        && (
          adminEmail()
          || (resource.data.role == 'customer' && request.resource.data.role == 'customer')
        );
      allow delete: if adminEmail();
    }

    match /businesses/{id} {
      allow read: if adminEmail();
      allow create, update: if adminEmail();
      allow delete: if false;
    }

    match /config/{id} {
      allow read, write: if adminEmail();
    }
  }
}
